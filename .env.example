# Local Neo4j credentials
SEVILLE_NEO4J_PASSWORD=replace-with-a-strong-database-password
# Print generated Cypher, parameters, selected roots, and query latency.
SEVILLE_NEO4J_QUERY_LOG=false

# Seville client-to-Go API authentication
SEVILLE_TOKEN=replace-with-a-strong-api-token

# Default user before authentication is implemented
SEVILLE_PLAYER_SLUG=mt22-primary-usersr

# Default root for graph-backed radial trees

# Alternative direct-folder source:
# SEVILLE_SOURCE=vault
# SEVILLE_VAULT_PATH=~/Documents/Obsidian/MyVault

# Remote Neo4j overrides, when the database moves off this Mac:
# SEVILLE_NEO4J_URI=neo4j+s://database.example.com:7687
# SEVILLE_NEO4J_USERNAME=neo4j
# SEVILLE_NEO4J_DATABASE=neo4j

# Remote Go API override for Seville clients:
# SEVILLE_BASE_URL=https://api.example.com
