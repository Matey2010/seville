SEVILLE_ADDR=127.0.0.1:8787
# Native commands accept /absolute/paths and ~/paths.
# Docker Compose requires an absolute path beginning with /.
SEVILLE_VAULT_PATH=~/Documents/Obsidian/MyVault
SEVILLE_DB_PATH=.local/seville.db
# Values are read literally, so generated tokens may contain shell characters.
SEVILLE_TOKEN=local-seville-token
# URL used by the Flutter client. Use the public HTTPS URL for a remote backend.
SEVILLE_BASE_URL=http://127.0.0.1:8787
