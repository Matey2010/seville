#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
PID_FILE="$ROOT/.local/seville.pid"
LOG_FILE="$ROOT/.local/seville.log"
BINARY="$ROOT/.local/seville-backend"

load_env() {
  if [ -f "$ROOT/.env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        ''|'#'*) continue ;;
      esac

      key=${line%%=*}
      raw=${line#*=}
      case "$key" in
        SEVILLE_ADDR|SEVILLE_SOURCE|SEVILLE_VAULT_PATH|SEVILLE_GIT_REPOSITORY_PATH|SEVILLE_GIT_VAULT_SUBPATH|SEVILLE_NEO4J_URI|SEVILLE_NEO4J_USERNAME|SEVILLE_NEO4J_PASSWORD|SEVILLE_NEO4J_DATABASE|SEVILLE_TOKEN) ;;
        *) continue ;;
      esac

      case "$raw" in
        \"*\") raw=${raw#\"}; raw=${raw%\"} ;;
        \'*\') raw=${raw#\'}; raw=${raw%\'} ;;
      esac
      export "$key=$raw"
    done <"$ROOT/.env"
  fi
  : "${SEVILLE_ADDR:=127.0.0.1:8787}"
  : "${SEVILLE_TOKEN:=local-seville-token}"
  : "${SEVILLE_SOURCE:=vault}"
  : "${SEVILLE_NEO4J_URI:=bolt://127.0.0.1:7687}"
  : "${SEVILLE_NEO4J_USERNAME:=neo4j}"
  : "${SEVILLE_NEO4J_PASSWORD:=seville-local-password}"
  : "${SEVILLE_NEO4J_DATABASE:=neo4j}"
  export SEVILLE_ADDR SEVILLE_TOKEN SEVILLE_SOURCE SEVILLE_NEO4J_URI
  export SEVILLE_NEO4J_USERNAME SEVILLE_NEO4J_PASSWORD SEVILLE_NEO4J_DATABASE
}

is_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

api_healthy() {
  curl --fail --silent --max-time 1 "http://$SEVILLE_ADDR/healthz" >/dev/null 2>&1
}

ensure_local_neo4j() {
  case "${SEVILLE_NEO4J_URI:-bolt://127.0.0.1:7687}" in
    neo4j://127.0.0.1:*|neo4j://localhost:*|bolt://127.0.0.1:*|bolt://localhost:*) ;;
    *) return 0 ;;
  esac

  if ! command -v docker >/dev/null 2>&1; then
    echo "Local Neo4j is configured, but Docker is unavailable." >&2
    echo "Install/start Docker Desktop or set SEVILLE_NEO4J_URI to the remote database." >&2
    exit 1
  fi
  attempts=0
  while ! docker info >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 30 ]; then
      echo "Docker Desktop is installed, but its engine did not become ready within 30 seconds." >&2
      echo "Docker's diagnostic follows:" >&2
      docker info >&2 || true
      echo "Set SEVILLE_NEO4J_URI to the remote database to bypass local Docker." >&2
      exit 1
    fi
    if [ "$attempts" -eq 1 ]; then
      echo "Waiting for the Docker Desktop engine..."
    fi
    sleep 1
  done
  (
    cd "$ROOT"
    docker compose up --detach neo4j
  )
}

start() {
  mkdir -p "$ROOT/.local"
  load_env
  if is_running && api_healthy; then
    echo "Seville is already running (PID $(cat "$PID_FILE"))."
    exit 0
  fi
  if is_running; then
    echo "Seville PID file exists, but the API is unhealthy; refusing to replace an unknown process." >&2
    echo "Inspect $PID_FILE and $LOG_FILE, then run './scripts/seville stop' if appropriate." >&2
    exit 1
  fi
  rm -f "$PID_FILE"
  ensure_local_neo4j
  (
    cd "$ROOT"
    go build -o "$BINARY" ./backend/cmd/seville
  )
  (
    cd "$ROOT"
    nohup "$BINARY" >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"
  )
  attempts=0
  while [ "$attempts" -lt 45 ]; do
    if api_healthy; then
      echo "Seville started at http://$SEVILLE_ADDR"
      echo "Log: $LOG_FILE"
      return 0
    fi
    if ! is_running; then
      rm -f "$PID_FILE"
      echo "Seville did not start. Check $LOG_FILE" >&2
      exit 1
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  echo "Seville API did not become healthy within 45 seconds. Check $LOG_FILE" >&2
  exit 1
}

serve() {
  mkdir -p "$ROOT/.local"
  load_env
  (
    cd "$ROOT"
    go build -o "$BINARY" ./backend/cmd/seville
  )
  cd "$ROOT"
  exec "$BINARY"
}

serve_built() {
  load_env
  if [ ! -x "$BINARY" ]; then
    echo "Seville backend is not built; run './scripts/seville start' first." >&2
    exit 1
  fi
  cd "$ROOT"
  exec "$BINARY"
}

stop() {
  if ! is_running; then
    rm -f "$PID_FILE"
    echo "Seville is not running."
    return 0
  fi
  pid=$(cat "$PID_FILE")
  kill "$pid"
  rm -f "$PID_FILE"
  echo "Seville stopped."
}

status() {
  load_env
  if ! is_running || ! api_healthy; then
    echo "Seville API is not running or unhealthy."
    exit 1
  fi
  echo "Seville process is running (PID $(cat "$PID_FILE"))."
  curl --fail --silent --show-error \
    -H "Authorization: Bearer $SEVILLE_TOKEN" \
    "http://$SEVILLE_ADDR/v1/status" \
    --output "$ROOT/.local/status.pb"
  echo "API is healthy. Protobuf status saved to .local/status.pb"
}

rescan() {
  load_env
  curl --fail --silent --show-error \
    -X POST \
    -H "Authorization: Bearer $SEVILLE_TOKEN" \
    "http://$SEVILLE_ADDR/v1/admin/rescan" \
    --output "$ROOT/.local/status.pb"
  echo "Vault rescan complete."
}

logs() {
  mkdir -p "$ROOT/.local"
  touch "$LOG_FILE"
  tail -n 80 -f "$LOG_FILE"
}

case "${1:-}" in
  start) start ;;
  serve) serve ;;
  serve-built) serve_built ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  rescan) rescan ;;
  logs) logs ;;
  *)
    echo "Usage: $0 {start|serve|serve-built|stop|restart|status|rescan|logs}" >&2
    exit 2
    ;;
esac
