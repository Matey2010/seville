#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

if [ -f "$ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    key=${line%%=*}
    raw=${line#*=}
    case "$key" in
      SEVILLE_TOKEN|SEVILLE_BASE_URL|SEVILLE_NEO4J_QUERY_LOG) ;;
      *) continue ;;
    esac
    case "$raw" in
      \"*\") raw=${raw#\"}; raw=${raw%\"} ;;
      \'*\') raw=${raw#\'}; raw=${raw%\'} ;;
    esac
    export "$key=$raw"
  done <"$ROOT/.env"
fi

"$ROOT/scripts/seville" start

LOG_TAIL_PID=""
cleanup_log_tail() {
  if [ -n "$LOG_TAIL_PID" ]; then
    kill "$LOG_TAIL_PID" 2>/dev/null || true
  fi
}
trap cleanup_log_tail EXIT

if [ "${SEVILLE_NEO4J_QUERY_LOG:-false}" = "true" ]; then
  tail -n 0 -f "$ROOT/.local/seville.log" &
  LOG_TAIL_PID=$!
fi

cd "$ROOT/seville/flutter"
flutter run \
  -d "${1:-macos}" \
  --dart-define="SEVILLE_BASE_URL=${SEVILLE_BASE_URL:-http://127.0.0.1:8787}" \
  --dart-define="SEVILLE_TOKEN=${SEVILLE_TOKEN:-local-seville-token}"
