#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

if [ -f "$ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    key=${line%%=*}
    raw=${line#*=}
    case "$key" in
      SEVILLE_TOKEN|SEVILLE_BASE_URL) ;;
      *) continue ;;
    esac
    case "$raw" in
      \"*\") raw=${raw#\"}; raw=${raw%\"} ;;
      \'*\') raw=${raw#\'}; raw=${raw%\'} ;;
    esac
    export "$key=$raw"
  done <"$ROOT/.env"
fi

cd "$ROOT/interface/flutter"
exec flutter run \
  -d "${1:-macos}" \
  --dart-define="SEVILLE_BASE_URL=${SEVILLE_BASE_URL:-http://127.0.0.1:8787}" \
  --dart-define="SEVILLE_TOKEN=${SEVILLE_TOKEN:-local-seville-token}"
