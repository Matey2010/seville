#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)

if [ -f "$ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac

    key=${line%%=*}
    raw=${line#*=}
    case "$key" in
      SEVILLE_SOURCE|SEVILLE_VAULT_PATH|SEVILLE_GIT_REPOSITORY_PATH|SEVILLE_GIT_VAULT_SUBPATH|SEVILLE_NEO4J_URI|SEVILLE_NEO4J_USERNAME|SEVILLE_NEO4J_PASSWORD|SEVILLE_NEO4J_DATABASE) ;;
      *) continue ;;
    esac

    case "$raw" in
      \"*\") raw=${raw#\"}; raw=${raw%\"} ;;
      \'*\') raw=${raw#\'}; raw=${raw%\'} ;;
    esac
    export "$key=$raw"
  done <"$ROOT/.env"
fi

cd "$ROOT"
exec go run ./backend/cmd/migrate-obsidian-vault
